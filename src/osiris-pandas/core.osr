(module osiris-pandas.core)

;; 三种契约形状。全部 :availability :immediate——本包不知道任何交易时点或领域时序，
;; 只描述数据依赖：逐行操作只看当前行，rolling 看 [t-window+1, t]，位移看 periods 行。
^{:doc
  {:default "Declare a row-wise pandas binding that reads only the current row."
   "zh-CN" "声明一个只读取当前行的逐行 pandas 绑定。"}}
(defmacro 逐行 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past 0
                 :future 0
                 :availability :immediate}
      :data {:alignment :labelled
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a rolling reducer over the causal window [t-window+1, t]."
   "zh-CN" "声明一个在因果窗口 [t-window+1, t] 上归约的 rolling 绑定。"}}
(defmacro 窗口 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past "window-1"
                 :future 0
                 :availability :immediate}
      :data {:axes [:entity :time]
             :alignment :labelled
             :ordered-by [:time]
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a binding that reads `periods` rows back along the order."
   "zh-CN" "声明一个沿排序回看 periods 行的绑定。"}}
(defmacro 位移 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past "periods"
                 :future 0
                 :availability :immediate}
      :data {:axes [:entity :time]
             :alignment :labelled
             :ordered-by [:time]
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a reduction that leaves the row axis and yields one value."
   "zh-CN" "声明一个离开行轴、归约为单个值的绑定。"}}
(defmacro 归约 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past :unbounded
                 :future :unbounded
                 :availability :immediate}
      :data {:preserves-length false
             :reshapes true
             :materializes true}}))

^{:doc
  {:default "Declare a binding that reads the whole column, later rows included."
   "zh-CN" "声明一个读取整列（含后续行）的绑定。"}}
(defmacro 整列 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past :unbounded
                 :future :unbounded
                 :availability :immediate}
      :data {:alignment :labelled
             :materializes true
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a reduction over every earlier row and no later one."
   "zh-CN" "声明一个归约所有在先行、且不读取后续行的绑定。"}}
(defmacro 累计 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past :unbounded
                 :future 0
                 :availability :immediate}
      :data {:axes [:entity :time]
             :alignment :labelled
             :ordered-by [:time]
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a binding that reads later rows and no earlier one."
   "zh-CN" "声明一个读取后续行、不读取在先行的绑定。"}}
(defmacro 前视 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past 0
                 :future :unbounded
                 :availability :immediate}
      :data {:axes [:entity :time]
             :alignment :labelled
             :ordered-by [:time]
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a binding that keeps the column but changes its row count."
   "zh-CN" "声明一个保留列、但改变行数的绑定。"}}
(defmacro 变长 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past :unbounded
                 :future :unbounded
                 :availability :immediate}
      :data {:materializes true
             :preserves-length false
             :reshapes false}}))

^{:doc
  {:default "Declare a grouped transform: one value per row, from its group."
   "zh-CN" "声明一个分组变换：每行一个值，取自该行所属的组。"}}
(defmacro 分组 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past :unbounded
                 :future :unbounded
                 :availability :immediate}
      :data {:axes [:entity]
             :alignment :labelled
             :materializes true
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a grouped transform that reads only earlier rows of its group."
   "zh-CN" "声明一个只读取同组在先行的分组变换。"}}
(defmacro 分组累计 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past :unbounded
                 :future 0
                 :availability :immediate}
      :data {:axes [:entity :time]
             :alignment :labelled
             :ordered-by [:time]
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a binding that builds or rearranges a frame."
   "zh-CN" "声明一个构建或重排数据框的绑定。"}}
(defmacro 重塑 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past :unbounded
                 :future :unbounded
                 :availability :immediate}
      :data {:materializes true
             :preserves-length false
             :reshapes true}}))

(py/embed pandas-backend "backend/primitives.py")

(extern python pandas-backend
  ^{:doc
    {:default "Sum over the causal window."
     "zh-CN" "在因果窗口上求和。"}
    :osiris/names {"zh-CN" {:preferred 窗口求和}}
    :export true}
  (窗口 rolling-sum
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Mean over the causal window."
     "zh-CN" "在因果窗口上求均值。"}
    :osiris/names {"zh-CN" {:preferred 窗口均值}}
    :export true}
  (窗口 rolling-mean
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Minimum over the causal window."
     "zh-CN" "在因果窗口上取最小值。"}
    :osiris/names {"zh-CN" {:preferred 窗口最小值}}
    :export true}
  (窗口 rolling-min
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Maximum over the causal window."
     "zh-CN" "在因果窗口上取最大值。"}
    :osiris/names {"zh-CN" {:preferred 窗口最大值}}
    :export true}
  (窗口 rolling-max
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Median over the causal window."
     "zh-CN" "在因果窗口上取中位数。"}
    :osiris/names {"zh-CN" {:preferred 窗口中位数}}
    :export true}
  (窗口 rolling-median
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Standard deviation over the causal window."
     "zh-CN" "在因果窗口上求标准差。"}
    :osiris/names {"zh-CN" {:preferred 窗口标准差}}
    :export true}
  (窗口 rolling-std
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Int ddof = 1] [^Any min-periods = none]])
  ^{:doc
    {:default "Correlation of two aligned series over the causal window."
     "zh-CN" "在因果窗口上求两条对齐序列的相关系数。"}
    :osiris/names {"zh-CN" {:preferred 窗口相关系数}}
    :export true}
  (窗口 rolling-correlation
        [^Any left ^Any right
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Exponentially weighted mean with the given span."
     "zh-CN" "按给定 span 求指数加权均值。"}
    :osiris/names {"zh-CN" {:preferred 指数加权均值}}
    :export true}
  (逐行
   ewm-mean
   [^Any values ^{:type Int :osiris/names {"zh-CN" {:preferred 跨度}}} span])
  ^{:doc
    {:default "Read a value `periods` rows back."
     "zh-CN" "读取回看 periods 行的值。"}
    :osiris/names {"zh-CN" {:preferred 位移}}
    :export true}
  (位移 shift
        [^Any values
         [^{:type Int :osiris/names {"zh-CN" {:preferred 期数}}} periods = 1]])
  ^{:doc
    {:default "Difference against the value `periods` rows back."
     "zh-CN" "与回看 periods 行的值之差。"}
    :osiris/names {"zh-CN" {:preferred 差分}}
    :export true}
  (位移 diff
        [^Any values
         [^{:type Int :osiris/names {"zh-CN" {:preferred 期数}}} periods = 1]])
  ^{:doc
    {:default "Relative change against the value `periods` rows back."
     "zh-CN" "相对回看 periods 行的值的变化率。"}
    :osiris/names {"zh-CN" {:preferred 变化率}}
    :export true}
  (位移 pct-change
        [^Any values
         [^{:type Int :osiris/names {"zh-CN" {:preferred 期数}}} periods = 1]])
  ^{:doc
    {:default "Whether each value is missing."
     "zh-CN" "逐行判断是否缺失。"}
    :osiris/names {"zh-CN" {:preferred 是否缺失}}
    :export true}
  (逐行 is-missing [^Any values])
  ^{:doc
    {:default "Replace missing values." "zh-CN" "替换缺失值。"}
    :osiris/names {"zh-CN" {:preferred 缺失值替换}}
    :export true}
  (逐行 fill-missing [^Any values [^Any replacement = 0]])
  ^{:doc
    {:default "Carry the last observed value forward."
     "zh-CN" "用最近一次观测值向前填充。"}
    :osiris/names {"zh-CN" {:preferred 前向填充}}
    :export true}
  (逐行 forward-fill [^Any values])
  ^{:doc
    {:default "Choose row by row on a condition."
     "zh-CN" "按条件逐行取值。"}
    :osiris/names {"zh-CN" {:preferred 按条件取值}}
    :export true}
  (逐行 where [^Any condition ^Any true-value ^Any false-value])
  ^{:doc
    {:default "Whether each value is one of the candidates."
     "zh-CN" "逐行判断是否属于候选集合。"}
    :osiris/names {"zh-CN" {:preferred 属于}}
    :export true}
  (逐行 in-values [^Any values ^Any candidates])
  ^{:doc
    {:default "Whether each text contains any of the needles."
     "zh-CN" "逐行判断文本是否包含任一子串。"}
    :osiris/names {"zh-CN" {:preferred 任含文本}}
    :export true}
  (逐行 contains-any [^Any values ^Any needles])
  ^{:doc
    {:default "Add elementwise." "zh-CN" "逐项相加。"}
    :osiris/names {"zh-CN" {:preferred 加}}
    :export true}
  (逐行 add [^Any left ^Any right])
  ^{:doc
    {:default "Subtract elementwise." "zh-CN" "逐项相减。"}
    :osiris/names {"zh-CN" {:preferred 减}}
    :export true}
  (逐行 subtract [^Any left ^Any right])
  ^{:doc
    {:default "Multiply elementwise." "zh-CN" "逐项相乘。"}
    :osiris/names {"zh-CN" {:preferred 乘}}
    :export true}
  (逐行 multiply [^Any left ^Any right])
  ^{:doc
    {:default "Divide elementwise." "zh-CN" "逐项相除。"}
    :osiris/names {"zh-CN" {:preferred 除}}
    :export true}
  (逐行 divide [^Any left ^Any right])
  ^{:doc
    {:default "Absolute value elementwise." "zh-CN" "逐项取绝对值。"}
    :osiris/names {"zh-CN" {:preferred 绝对值}}
    :export true}
  (逐行 absolute [^Any values])
  ^{:doc
    {:default "Natural log of one plus each value."
     "zh-CN" "逐项计算 log(1+x)。"}
    :osiris/names {"zh-CN" {:preferred 对数1p}}
    :export true}
  (逐行 log1p [^Any values])
  ^{:doc
    {:default "Convert to a nullable integer dtype."
     "zh-CN" "转换为可空整数类型。"}
    :osiris/names {"zh-CN" {:preferred 转整数}}
    :export true}
  (逐行 as-integer [^Any values])
  ^{:doc
    {:default "Larger of the two, elementwise."
     "zh-CN" "逐项取较大值。"}
    :osiris/names {"zh-CN" {:preferred 逐项最大值}}
    :export true}
  (逐行 elementwise-max [^Any left ^Any right])
  ^{:doc
    {:default "Smaller of the two, elementwise."
     "zh-CN" "逐项取较小值。"}
    :osiris/names {"zh-CN" {:preferred 逐项最小值}}
    :export true}
  (逐行 elementwise-min [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `>`." "zh-CN" "逐项大于。"}
    :osiris/names {"zh-CN" {:preferred 大于}}
    :export true}
  (逐行 greater-than [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `>=`." "zh-CN" "逐项大于等于。"}
    :osiris/names {"zh-CN" {:preferred 大于等于}}
    :export true}
  (逐行 greater-equal [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `<`." "zh-CN" "逐项小于。"}
    :osiris/names {"zh-CN" {:preferred 小于}}
    :export true}
  (逐行 less-than [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `<=`." "zh-CN" "逐项小于等于。"}
    :osiris/names {"zh-CN" {:preferred 小于等于}}
    :export true}
  (逐行 less-equal [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `==`." "zh-CN" "逐项等于。"}
    :osiris/names {"zh-CN" {:preferred 等于}}
    :export true}
  (逐行 equal [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `!=`." "zh-CN" "逐项不等于。"}
    :osiris/names {"zh-CN" {:preferred 不等于}}
    :export true}
  (逐行 not-equal [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise conjunction." "zh-CN" "逐项且。"}
    :osiris/names {"zh-CN" {:preferred 且}}
    :export true}
  (逐行 logical-and [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise disjunction." "zh-CN" "逐项或。"}
    :osiris/names {"zh-CN" {:preferred 或}}
    :export true}
  (逐行 logical-or [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise negation." "zh-CN" "逐项非。"}
    :osiris/names {"zh-CN" {:preferred 非}}
    :export true}
  (逐行 logical-not [^Any value])
  ^{:doc
    {:default "Sum across the given series, row by row."
     "zh-CN" "跨给定序列逐行求和。"}
    :osiris/names {"zh-CN" {:preferred 横向求和}}
    :export true}
  (逐行 row-sum [& ^Any values])
  ^{:doc
    {:default "Mean across the given series, row by row."
     "zh-CN" "跨给定序列逐行求均值。"}
    :osiris/names {"zh-CN" {:preferred 横向均值}}
    :export true}
  (逐行 row-mean [& ^Any values])
  ^{:doc
    {:default "Maximum across the given series, row by row."
     "zh-CN" "跨给定序列逐行取最大值。"}
    :osiris/names {"zh-CN" {:preferred 横向最大值}}
    :export true}
  (逐行 row-max [& ^Any values])
  ^{:doc
    {:default "Minimum across the given series, row by row."
     "zh-CN" "跨给定序列逐行取最小值。"}
    :osiris/names {"zh-CN" {:preferred 横向最小值}}
    :export true}
  (逐行 row-min [& ^Any values])
  ^{:doc
    {:default "Sum of the whole series." "zh-CN" "整列求和。"}
    :osiris/names {"zh-CN" {:preferred 总和}}
    :export true}
  (归约 series-sum [^Any values])
  ^{:doc
    {:default "Mean of the whole series." "zh-CN" "整列均值。"}
    :osiris/names {"zh-CN" {:preferred 总均值}}
    :export true}
  (归约 series-mean [^Any values])
  ^{:doc
    {:default "Minimum of the whole series." "zh-CN" "整列最小值。"}
    :osiris/names {"zh-CN" {:preferred 总最小值}}
    :export true}
  (归约 series-min [^Any values])
  ^{:doc
    {:default "Maximum of the whole series." "zh-CN" "整列最大值。"}
    :osiris/names {"zh-CN" {:preferred 总最大值}}
    :export true}
  (归约 series-max [^Any values])
  ^{:doc
    {:default "Median of the whole series." "zh-CN" "整列中位数。"}
    :osiris/names {"zh-CN" {:preferred 总中位数}}
    :export true}
  (归约 series-median [^Any values])
  ^{:doc
    {:default "Standard deviation of the whole series."
     "zh-CN" "整列标准差。"}
    :osiris/names {"zh-CN" {:preferred 总标准差}}
    :export true}
  (归约 series-std [^Any values [^Int ddof = 1]])
  ^{:doc
    {:default "Number of non-missing values." "zh-CN" "非缺失值个数。"}
    :osiris/names {"zh-CN" {:preferred 计数}}
    :export true}
  (归约 series-count [^Any values])
  ^{:doc
    {:default "Number of distinct values." "zh-CN" "不同取值个数。"}
    :osiris/names {"zh-CN" {:preferred 去重计数}}
    :export true}
  (归约 series-nunique [^Any values])
  ^{:doc
    {:default "Quantile of the whole series." "zh-CN" "整列分位数。"}
    :osiris/names {"zh-CN" {:preferred 分位数}}
    :export true}
  (归约 series-quantile
        [^Any values ^{:type Float :osiris/names {"zh-CN" {:preferred 分位}}} q])
  ^{:doc
    {:default "Whether any value is true." "zh-CN" "是否存在为真的值。"}
    :osiris/names {"zh-CN" {:preferred 任一为真}}
    :export true}
  (归约 series-any [^Any values])
  ^{:doc
    {:default "Whether every value is true." "zh-CN" "是否全部为真。"}
    :osiris/names {"zh-CN" {:preferred 全部为真}}
    :export true}
  (归约 series-all [^Any values])
  ^{:doc
    {:default "Rank within the whole column." "zh-CN" "在整列内求秩。"}
    :osiris/names {"zh-CN" {:preferred 秩}}
    :export true}
  (整列 rank [^Any values [^Str method = "average"] [^Bool ascending = true]])
  ^{:doc
    {:default "Rank within the whole column, as a fraction."
     "zh-CN" "在整列内求百分位秩。"}
    :osiris/names {"zh-CN" {:preferred 百分位秩}}
    :export true}
  (整列 percent-rank [^Any values [^Bool ascending = true]])
  ^{:doc
    {:default "Running sum from the first row."
     "zh-CN" "自首行起的累计和。"}
    :osiris/names {"zh-CN" {:preferred 累计和}}
    :export true}
  (累计 cumulative-sum [^Any values])
  ^{:doc
    {:default "Running product from the first row."
     "zh-CN" "自首行起的累计积。"}
    :osiris/names {"zh-CN" {:preferred 累计积}}
    :export true}
  (累计 cumulative-product [^Any values])
  ^{:doc
    {:default "Running maximum from the first row."
     "zh-CN" "自首行起的累计最大值。"}
    :osiris/names {"zh-CN" {:preferred 累计最大值}}
    :export true}
  (累计 cumulative-max [^Any values])
  ^{:doc
    {:default "Running minimum from the first row."
     "zh-CN" "自首行起的累计最小值。"}
    :osiris/names {"zh-CN" {:preferred 累计最小值}}
    :export true}
  (累计 cumulative-min [^Any values])
  ^{:doc
    {:default "Sum over every row so far."
     "zh-CN" "对目前为止所有行求和。"}
    :osiris/names {"zh-CN" {:preferred 扩展求和}}
    :export true}
  (累计 expanding-sum [^Any values [^Int min-periods = 1]])
  ^{:doc
    {:default "Mean over every row so far."
     "zh-CN" "对目前为止所有行求均值。"}
    :osiris/names {"zh-CN" {:preferred 扩展均值}}
    :export true}
  (累计 expanding-mean [^Any values [^Int min-periods = 1]])
  ^{:doc
    {:default "Minimum over every row so far."
     "zh-CN" "对目前为止所有行取最小值。"}
    :osiris/names {"zh-CN" {:preferred 扩展最小值}}
    :export true}
  (累计 expanding-min [^Any values [^Int min-periods = 1]])
  ^{:doc
    {:default "Maximum over every row so far."
     "zh-CN" "对目前为止所有行取最大值。"}
    :osiris/names {"zh-CN" {:preferred 扩展最大值}}
    :export true}
  (累计 expanding-max [^Any values [^Int min-periods = 1]])
  ^{:doc
    {:default "Standard deviation over every row so far."
     "zh-CN" "对目前为止所有行求标准差。"}
    :osiris/names {"zh-CN" {:preferred 扩展标准差}}
    :export true}
  (累计 expanding-std [^Any values [^Int min-periods = 2] [^Int ddof = 1]])
  ^{:doc
    {:default "Bound each value to a range."
     "zh-CN" "把每个值限制在区间内。"}
    :osiris/names {"zh-CN" {:preferred 限幅}}
    :export true}
  (逐行 clip [^Any values [^Any lower = none] [^Any upper = none]])
  ^{:doc
    {:default "Round to the given number of digits."
     "zh-CN" "按给定位数四舍五入。"}
