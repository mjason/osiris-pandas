  (分组
   group-mean
   [^Any values ^{:type Any :osiris/names {"zh-CN" {:preferred 分组键}}} keys])
  ^{:doc
    {:default "Minimum within each group." "zh-CN" "组内最小值。"}
    :osiris/names {"zh-CN" {:preferred 组内最小值}}
