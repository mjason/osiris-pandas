  ^{:doc
    {:default "Sum within each group." "zh-CN" "组内求和。"}
    :osiris/names {"zh-CN" {:preferred 组内求和}}
    :export true}
  (分组
   group-sum
   [^Any values ^{:type Any :osiris/names {"zh-CN" {:preferred 分组键}}} keys])
  ^{:doc
    {:default "Mean within each group." "zh-CN" "组内均值。"}
    :osiris/names {"zh-CN" {:preferred 组内均值}}
