(module osiris_pandas.core)

;; 三种契约形状。全部 :availability :immediate——本包不知道任何交易时点或领域时序，
;; 只描述数据依赖：逐行操作只看当前行，rolling 看 [t-window+1, t]，位移看 periods 行。
^{:doc
  {:default "Declare a row-wise pandas binding that reads only the current row."
   "zh-CN" "声明一个只读取当前行的逐行 pandas 绑定。"}}
(defmacro 逐行 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past 0
                 :future 0
                 :availability :immediate}
      :data {:alignment :labelled
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a rolling reducer over the causal window [t-window+1, t]."
   "zh-CN" "声明一个在因果窗口 [t-window+1, t] 上归约的 rolling 绑定。"}}
(defmacro 窗口 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past "window-1"
                 :future 0
                 :availability :immediate}
      :data {:axes [:entity :time]
             :alignment :labelled
             :ordered-by [:time]
             :preserves-length true
             :reshapes false}}))

^{:doc
  {:default "Declare a binding that reads `periods` rows back along the order."
   "zh-CN" "声明一个沿排序回看 periods 行的绑定。"}}
(defmacro 位移 [name params]
  `(defn ^Any ~name ~params
     :contract
     {:id ~(str "osiris-pandas/" name "-v1")
      :effects :pure
      :temporal {:past "periods"
                 :future 0
                 :availability :immediate}
      :data {:axes [:entity :time]
             :alignment :labelled
             :ordered-by [:time]
             :preserves-length true
             :reshapes false}}))

~python<pandas-backend>
"""Pandas primitives with explicit, causal window semantics.

Every rolling reducer reads `[t-window+1, t]` and never a future row. That is
what lets the Osiris declarations state a temporal reach the compiler can check,
and it is the only opinion this module holds. Nothing here knows about trading
sessions, factors, or any other domain.

Each function is a thin, typed spelling of a pandas or numpy operation. Where
pandas would silently accept a nonsensical argument, these raise instead, so a
mistake surfaces at the call rather than as a quietly wrong column.
"""

from __future__ import annotations

from typing import Any

import numpy as np
import pandas as pd


def _positive_int(value: int, name: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        raise ValueError(f"{name} must be a positive integer, got {value!r}")
    return value


def _window(window: int, min_periods: int | None) -> tuple[int, int]:
    window = _positive_int(window, "window")
    if min_periods is None:
        min_periods = window
    min_periods = _positive_int(min_periods, "min_periods")
    if min_periods > window:
        raise ValueError("min_periods cannot exceed window")
    return window, min_periods


def _rolling(values: pd.Series, window: int, min_periods: int | None) -> Any:
    window, min_periods = _window(window, min_periods)
    return values.rolling(window=window, min_periods=min_periods, center=False)


# Rolling reducers over [t-window+1, t].


def rolling_sum(
    values: pd.Series, window: int, min_periods: int | None = None
) -> pd.Series:
    return _rolling(values, window, min_periods).sum()


def rolling_mean(
    values: pd.Series, window: int, min_periods: int | None = None
) -> pd.Series:
    return _rolling(values, window, min_periods).mean()


def rolling_min(
    values: pd.Series, window: int, min_periods: int | None = None
) -> pd.Series:
    return _rolling(values, window, min_periods).min()


def rolling_max(
    values: pd.Series, window: int, min_periods: int | None = None
) -> pd.Series:
    return _rolling(values, window, min_periods).max()


def rolling_median(
    values: pd.Series, window: int, min_periods: int | None = None
) -> pd.Series:
    return _rolling(values, window, min_periods).median()


def rolling_std(
    values: pd.Series, window: int, ddof: int = 1, min_periods: int | None = None
) -> Any:
    if isinstance(ddof, bool) or not isinstance(ddof, int) or ddof < 0:
        raise ValueError(f"ddof must be a non-negative integer, got {ddof!r}")
    return _rolling(values, window, min_periods).std(ddof=ddof)


def rolling_correlation(
    left: pd.Series, right: pd.Series, window: int, min_periods: int | None = None
) -> Any:
    if not left.index.equals(right.index):
        raise ValueError("correlated series must have identical labelled indexes")
    return _rolling(left, window, min_periods).corr(right)


def ewm_mean(values: pd.Series, span: int) -> pd.Series:
    span = _positive_int(span, "span")
    return values.ewm(span=span, adjust=False).mean()


# Shifting along the ordered axis. Negative periods would read the future.


def shift(values: pd.Series, periods: int = 1) -> pd.Series:
    if isinstance(periods, bool) or not isinstance(periods, int) or periods < 0:
        raise ValueError(f"periods must be a non-negative integer, got {periods!r}")
    return values.shift(periods)


def diff(values: pd.Series, periods: int = 1) -> pd.Series:
    return values - shift(values, periods)


def pct_change(values: pd.Series, periods: int = 1) -> pd.Series:
    return values / shift(values, periods) - 1


# Missing data.


def is_missing(values: Any) -> Any:
    return pd.isna(values)


def fill_missing(values: Any, replacement: Any = 0) -> Any:
    return values.fillna(replacement)


def forward_fill(values: Any) -> Any:
    return values.ffill()


# Row-wise selection and membership.


def where(condition: pd.Series, true_value: Any, false_value: Any) -> pd.Series:
    """Row-wise choice that keeps the condition's index."""
    result = pd.Series(true_value, index=condition.index)
    return result.where(condition, false_value)


def in_values(values: pd.Series, candidates: Any) -> pd.Series:
    return values.isin(list(candidates))


def contains_any(values: pd.Series, needles: Any) -> pd.Series:
    needles = list(needles)
    if not needles:
        return pd.Series(False, index=values.index)
    pattern = "|".join(
        pd.Series(needles, dtype="string").str.replace(
            r"([.^$*+?()\[\]{}|\\])", r"\\\1", regex=True
        )
    )
    return values.str.contains(pattern, na=False, regex=True)


# Elementwise arithmetic and comparison. These exist so a declaration can carry
# a checked contract, not because pandas lacks the operator.


def add(left: Any, right: Any) -> Any:
    return left + right


def subtract(left: Any, right: Any) -> Any:
    return left - right


def multiply(left: Any, right: Any) -> Any:
    return left * right


def divide(left: Any, right: Any) -> Any:
    return left / right


def absolute(values: Any) -> Any:
    return abs(values)


def log1p(values: Any) -> Any:
    return np.log1p(values)


def as_integer(values: Any) -> Any:
    return values.astype("Int64")


def elementwise_max(left: Any, right: Any) -> Any:
    return np.maximum(left, right)


def elementwise_min(left: Any, right: Any) -> Any:
    return np.minimum(left, right)


def greater_than(left: Any, right: Any) -> Any:
    return left > right


def greater_equal(left: Any, right: Any) -> Any:
    return left >= right


def less_than(left: Any, right: Any) -> Any:
    return left < right


def less_equal(left: Any, right: Any) -> Any:
    return left <= right


def equal(left: Any, right: Any) -> Any:
    return left == right


def not_equal(left: Any, right: Any) -> Any:
    return left != right


def logical_and(left: Any, right: Any) -> Any:
    return left & right


def logical_or(left: Any, right: Any) -> Any:
    return left | right


def logical_not(value: Any) -> Any:
    return ~value


# Across several aligned series, row by row.


def _align(values: tuple[Any, ...]) -> pd.DataFrame:
    series = next((value for value in values if isinstance(value, pd.Series)), None)
    if series is None:
        raise ValueError("at least one argument must be a Series")
    columns = [
        value if isinstance(value, pd.Series) else pd.Series(value, index=series.index)
        for value in values
    ]
    return pd.concat(columns, axis=1)


def row_sum(*values: Any) -> pd.Series:
    return _align(values).sum(axis=1, skipna=True)


def row_mean(*values: Any) -> pd.Series:
    return _align(values).mean(axis=1, skipna=True)


def row_max(*values: Any) -> pd.Series:
    return _align(values).max(axis=1, skipna=True)


def row_min(*values: Any) -> pd.Series:
    return _align(values).min(axis=1, skipna=True)
</pandas-backend>

(extern python pandas-backend
  ^{:doc
    {:default "Sum over the causal window."
     "zh-CN" "在因果窗口上求和。"}
    :osiris/names {"zh-CN" {:preferred 窗口求和}}
    :export true}
  (窗口 rolling-sum
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Mean over the causal window."
     "zh-CN" "在因果窗口上求均值。"}
    :osiris/names {"zh-CN" {:preferred 窗口均值}}
    :export true}
  (窗口 rolling-mean
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Minimum over the causal window."
     "zh-CN" "在因果窗口上取最小值。"}
    :osiris/names {"zh-CN" {:preferred 窗口最小值}}
    :export true}
  (窗口 rolling-min
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Maximum over the causal window."
     "zh-CN" "在因果窗口上取最大值。"}
    :osiris/names {"zh-CN" {:preferred 窗口最大值}}
    :export true}
  (窗口 rolling-max
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Median over the causal window."
     "zh-CN" "在因果窗口上取中位数。"}
    :osiris/names {"zh-CN" {:preferred 窗口中位数}}
    :export true}
  (窗口 rolling-median
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Standard deviation over the causal window."
     "zh-CN" "在因果窗口上求标准差。"}
    :osiris/names {"zh-CN" {:preferred 窗口标准差}}
    :export true}
  (窗口 rolling-std
        [^Any values
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Int ddof = 1] [^Any min-periods = none]])
  ^{:doc
    {:default "Correlation of two aligned series over the causal window."
     "zh-CN" "在因果窗口上求两条对齐序列的相关系数。"}
    :osiris/names {"zh-CN" {:preferred 窗口相关系数}}
    :export true}
  (窗口 rolling-correlation
        [^Any left ^Any right
         ^{:type Int :osiris/names {"zh-CN" {:preferred 窗口大小}}} window
         [^Any min-periods = none]])
  ^{:doc
    {:default "Exponentially weighted mean with the given span."
     "zh-CN" "按给定 span 求指数加权均值。"}
    :osiris/names {"zh-CN" {:preferred 指数加权均值}}
    :export true}
  (逐行
   ewm-mean
   [^Any values ^{:type Int :osiris/names {"zh-CN" {:preferred 跨度}}} span])
  ^{:doc
    {:default "Read a value `periods` rows back."
     "zh-CN" "读取回看 periods 行的值。"}
    :osiris/names {"zh-CN" {:preferred 位移}}
    :export true}
  (位移 shift
        [^Any values
         [^{:type Int :osiris/names {"zh-CN" {:preferred 期数}}} periods = 1]])
  ^{:doc
    {:default "Difference against the value `periods` rows back."
     "zh-CN" "与回看 periods 行的值之差。"}
    :osiris/names {"zh-CN" {:preferred 差分}}
    :export true}
  (位移 diff
        [^Any values
         [^{:type Int :osiris/names {"zh-CN" {:preferred 期数}}} periods = 1]])
  ^{:doc
    {:default "Relative change against the value `periods` rows back."
     "zh-CN" "相对回看 periods 行的值的变化率。"}
    :osiris/names {"zh-CN" {:preferred 变化率}}
    :export true}
  (位移 pct-change
        [^Any values
         [^{:type Int :osiris/names {"zh-CN" {:preferred 期数}}} periods = 1]])
  ^{:doc
    {:default "Whether each value is missing."
     "zh-CN" "逐行判断是否缺失。"}
    :osiris/names {"zh-CN" {:preferred 是否缺失}}
    :export true}
  (逐行 is-missing [^Any values])
  ^{:doc
    {:default "Replace missing values." "zh-CN" "替换缺失值。"}
    :osiris/names {"zh-CN" {:preferred 缺失值替换}}
    :export true}
  (逐行 fill-missing [^Any values [^Any replacement = 0]])
  ^{:doc
    {:default "Carry the last observed value forward."
     "zh-CN" "用最近一次观测值向前填充。"}
    :osiris/names {"zh-CN" {:preferred 前向填充}}
    :export true}
  (逐行 forward-fill [^Any values])
  ^{:doc
    {:default "Choose row by row on a condition."
     "zh-CN" "按条件逐行取值。"}
    :osiris/names {"zh-CN" {:preferred 按条件取值}}
    :export true}
  (逐行 where [^Any condition ^Any true-value ^Any false-value])
  ^{:doc
    {:default "Whether each value is one of the candidates."
     "zh-CN" "逐行判断是否属于候选集合。"}
    :osiris/names {"zh-CN" {:preferred 属于}}
    :export true}
  (逐行 in-values [^Any values ^Any candidates])
  ^{:doc
    {:default "Whether each text contains any of the needles."
     "zh-CN" "逐行判断文本是否包含任一子串。"}
    :osiris/names {"zh-CN" {:preferred 任含文本}}
    :export true}
  (逐行 contains-any [^Any values ^Any needles])
  ^{:doc
    {:default "Add elementwise." "zh-CN" "逐项相加。"}
    :osiris/names {"zh-CN" {:preferred 加}}
    :export true}
  (逐行 add [^Any left ^Any right])
  ^{:doc
    {:default "Subtract elementwise." "zh-CN" "逐项相减。"}
    :osiris/names {"zh-CN" {:preferred 减}}
    :export true}
  (逐行 subtract [^Any left ^Any right])
  ^{:doc
    {:default "Multiply elementwise." "zh-CN" "逐项相乘。"}
    :osiris/names {"zh-CN" {:preferred 乘}}
    :export true}
  (逐行 multiply [^Any left ^Any right])
  ^{:doc
    {:default "Divide elementwise." "zh-CN" "逐项相除。"}
    :osiris/names {"zh-CN" {:preferred 除}}
    :export true}
  (逐行 divide [^Any left ^Any right])
  ^{:doc
    {:default "Absolute value elementwise." "zh-CN" "逐项取绝对值。"}
    :osiris/names {"zh-CN" {:preferred 绝对值}}
    :export true}
  (逐行 absolute [^Any values])
  ^{:doc
    {:default "Natural log of one plus each value."
     "zh-CN" "逐项计算 log(1+x)。"}
    :osiris/names {"zh-CN" {:preferred 对数1p}}
    :export true}
  (逐行 log1p [^Any values])
  ^{:doc
    {:default "Convert to a nullable integer dtype."
     "zh-CN" "转换为可空整数类型。"}
    :osiris/names {"zh-CN" {:preferred 转整数}}
    :export true}
  (逐行 as-integer [^Any values])
  ^{:doc
    {:default "Larger of the two, elementwise."
     "zh-CN" "逐项取较大值。"}
    :osiris/names {"zh-CN" {:preferred 逐项最大值}}
    :export true}
  (逐行 elementwise-max [^Any left ^Any right])
  ^{:doc
    {:default "Smaller of the two, elementwise."
     "zh-CN" "逐项取较小值。"}
    :osiris/names {"zh-CN" {:preferred 逐项最小值}}
    :export true}
  (逐行 elementwise-min [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `>`." "zh-CN" "逐项大于。"}
    :osiris/names {"zh-CN" {:preferred 大于}}
    :export true}
  (逐行 greater-than [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `>=`." "zh-CN" "逐项大于等于。"}
    :osiris/names {"zh-CN" {:preferred 大于等于}}
    :export true}
  (逐行 greater-equal [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `<`." "zh-CN" "逐项小于。"}
    :osiris/names {"zh-CN" {:preferred 小于}}
    :export true}
  (逐行 less-than [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `<=`." "zh-CN" "逐项小于等于。"}
    :osiris/names {"zh-CN" {:preferred 小于等于}}
    :export true}
  (逐行 less-equal [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `==`." "zh-CN" "逐项等于。"}
    :osiris/names {"zh-CN" {:preferred 等于}}
    :export true}
  (逐行 equal [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise `!=`." "zh-CN" "逐项不等于。"}
    :osiris/names {"zh-CN" {:preferred 不等于}}
    :export true}
  (逐行 not-equal [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise conjunction." "zh-CN" "逐项且。"}
    :osiris/names {"zh-CN" {:preferred 且}}
    :export true}
  (逐行 logical-and [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise disjunction." "zh-CN" "逐项或。"}
    :osiris/names {"zh-CN" {:preferred 或}}
    :export true}
  (逐行 logical-or [^Any left ^Any right])
  ^{:doc
    {:default "Elementwise negation." "zh-CN" "逐项非。"}
    :osiris/names {"zh-CN" {:preferred 非}}
    :export true}
  (逐行 logical-not [^Any value])
  ^{:doc
    {:default "Sum across the given series, row by row."
     "zh-CN" "跨给定序列逐行求和。"}
    :osiris/names {"zh-CN" {:preferred 横向求和}}
    :export true}
  (逐行 row-sum [& ^Any values])
  ^{:doc
    {:default "Mean across the given series, row by row."
     "zh-CN" "跨给定序列逐行求均值。"}
    :osiris/names {"zh-CN" {:preferred 横向均值}}
    :export true}
  (逐行 row-mean [& ^Any values])
  ^{:doc
    {:default "Maximum across the given series, row by row."
     "zh-CN" "跨给定序列逐行取最大值。"}
    :osiris/names {"zh-CN" {:preferred 横向最大值}}
    :export true}
  (逐行 row-max [& ^Any values])
  ^{:doc
    {:default "Minimum across the given series, row by row."
     "zh-CN" "跨给定序列逐行取最小值。"}
    :osiris/names {"zh-CN" {:preferred 横向最小值}}
    :export true}
  (逐行 row-min [& ^Any values]))
